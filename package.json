{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal or a local web view.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node --test tests/e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:standalone": "node scripts/build-standalone.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@happy-dom/global-registrator": "^21.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2"
  }
}
